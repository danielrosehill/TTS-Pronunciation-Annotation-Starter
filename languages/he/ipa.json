   "letters": "ח; כ / ך without dagesh",
   "sounds_like": "Scottish \"loch\", German \"Bach\"",
   "example": "חַנָּה ˈχana · לֶחֶם ˈleχem",
   "common_errors": [
    "tʃ (English \"ch\", as in chana masala)",
    "k",
    "h",
    "silent",
