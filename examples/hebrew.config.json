{
  "title": "Hebrew TTS listening notes",
  "language": "he",
  "rtl": true,
  "font_stack": "\"Noto Sans Hebrew\", \"Arial Hebrew\", Arial, sans-serif",
  "language_pack": "he",
  "fields": {
    "display": "text_nikud",
    "secondary": "text",
    "gloss": "english"
  },
  "axes": [
    {
      "key": "naturalness",
      "type": "scale",
      "label": "Naturalness",
      "hint": "Does it sound like a person?"
    },
    {
      "key": "clarity",
      "type": "scale",
      "label": "Clarity",
      "hint": "Every syllable easy to make out and copy?"
    },
    {
      "key": "hebrew",
      "type": "scale",
      "label": "Hebrew accuracy",
      "hint": "Right words, stress and Israeli accent?"
    }
  ],
  "minor_tags": [
    "Skipped",
    "Added sound",
    "Unnatural pause",
    "Accent",
    "Other"
  ],
  "reference_label": "Machine reference: check it",
  "notes_repo": "your-user/your-annotations-dataset",
  "evals_registry": "https://huggingface.co/datasets/Hebrish/Hebrew-TTS-Evaluations/resolve/main/evals.jsonl",
  "passes": {
    "screen": true,
    "rank": true,
    "quality": false
  },
  "fail_reasons": [
    "Mispronunciation",
    "Wrong emphasis (stress)",
    "Glitch / artefact",
    "Truncated / skipped words",
    "Wrong voice or language",
    "Other"
  ],
  "gender": {
    "label": "Voice gender",
    "options": {
      "female": "f",
      "male": "m",
      "unclear": "u"
    }
  },
  "rank": {
    "pairing": "playoff"
  },
  "other_reason": "Other",
  "tag_reasons": {
    "stress": "Wrong emphasis (stress)",
    "mispronunciation": "Mispronunciation"
  },
  "rank_reject_reason": "Rejected in ranking (both bad)"
}
