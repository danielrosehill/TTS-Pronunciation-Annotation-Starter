{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielrosehill/TTS-Pronunciation-Annotation-Starter/schema/annotation.schema.json",
  "title": "Screen row (tts-annotation/2)",
  "description": "One line of annotations/<eval_id>/screen.jsonl (pass 1 of 'screen, then rank'): the whole clip passes or fails; a fail needs one or more clip-level fail_reasons. word_issues and scores are an optional detail layer. Append-only: the latest line per (run, sentence) wins.",
  "type": "object",
  "required": [
    "schema",
    "eval_id",
    "run",
    "sentence",
    "verdict",
    "saved"
  ],
  "properties": {
    "schema": {
      "const": "tts-annotation/2"
    },
    "eval_id": {
      "type": "string"
    },
    "run": {
      "type": "string",
      "description": "Model run slug from the clip manifest"
    },
    "run_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {
      "type": [
        "string",
        "null"
      ],
      "description": "How the run was fed (e.g. plain, nikud)"
    },
    "sentence": {
      "type": "string",
      "description": "Sentence id, or \"overall\" for a note on the run as a whole"
    },
    "gender": {
      "type": [
        "string",
        "null"
      ],
      "description": "Voice gender heard: a key of config gender.options (default female, male, unclear)"
    },
    "scores": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional detail layer: quality rows (config axes, when passes.quality): scale 1-5, binary yes/no, or a choice option",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "note": {
      "type": "string"
    },
    "blind": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "source": {
      "enum": [
        "screen",
        "rank"
      ],
      "description": "rank = a late fail from a 'both bad' comparison"
    },
    "client_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "saved": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ],
      "description": "Pass 1 judges the whole clip (the sentence as rendered)"
    },
    "fail_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clip-level categories (config fail_reasons; default Mispronunciation, Wrong emphasis (stress), Glitch / artefact, Truncated / skipped words, Wrong voice or language, Other). Required (one or more) on a fail. 'Rejected in ranking (both bad)' marks a late fail from pass 2."
    },
    "word_issues": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "title": "Stress on the wrong syllable",
            "required": [
              "type",
              "word",
              "position",
              "syllables",
              "heard",
              "correct"
            ],
            "properties": {
              "type": {
                "const": "stress"
              },
              "word": {
                "type": "string"
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "description": "1-based word position in reading order"
              },
              "syllables": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "heard": {
                "type": "integer",
                "minimum": 0,
                "description": "0-based index of the syllable the voice stressed"
              },
              "correct": {
                "type": "integer",
                "minimum": 0,
                "description": "0-based index of the syllable that should be stressed"
              },
              "comment": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "title": "Mispronunciation",
            "required": [
              "type",
              "word",
              "position",
              "ipa_heard",
              "ipa_expected"
            ],
            "properties": {
              "type": {
                "const": "mispronunciation"
              },
              "word": {
                "type": "string"
              },
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "ipa_heard": {
                "type": "string",
                "description": "IPA of what the voice said"
              },
              "ipa_expected": {
                "type": "string",
                "description": "IPA of what it should have said"
              },
              "comment": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "title": "Minor tag (one word or a span)",
            "required": [
              "type",
              "words",
              "positions",
              "tags"
            ],
            "properties": {
              "type": {
                "const": "minor"
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "positions": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "From config minor_tags"
              },
              "comment": {
                "type": "string"
              }
            }
          }
        ]
      },
      "description": "Optional detail layer: structured word-level issues (stress heard vs should be, IPA heard vs expected, minor tags). Never required."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "fail"
          },
          "sentence": {
            "not": {
              "const": "overall"
            }
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "fail_reasons"
        ],
        "properties": {
          "fail_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
